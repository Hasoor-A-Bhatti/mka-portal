# Copy to .env.local for local development, and add the same two values
# in Vercel → Project → Settings → Environment Variables.
# Find them in Supabase → Project Settings → API (or "API Keys").

NEXT_PUBLIC_SUPABASE_URL=https://nzjbqkoonetojtwwtsko.supabase.co

# The anon / publishable key. Safe in the browser: row-level security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_uFRmPTHcWnpmOjZ4kowxQg_rCJ0uJu7

# Never add the service_role / secret key here. The app doesn't need it.

# Google Calendar for the Delegations dashboard (server only, never NEXT_PUBLIC_).
# See "Delegations calendar" in the README. Add all four in Vercel too.
GOOGLE_CALENDAR_ID=delegations@khuddam.co.uk
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Filled in by `npm run calendar:auth` after the calendar owner signs in.
GOOGLE_OAUTH_REFRESH_TOKEN=
